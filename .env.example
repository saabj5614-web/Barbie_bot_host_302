# Pterodactyl connection (server-side only)
PTERO_PANEL_URL=https://panel.example.com
PTERO_APP_API_KEY=
PTERO_CLIENT_API_KEY=

# Owner-only gate
OWNER_PASSWORD=change-this-to-a-long-random-password
OWNER_COOKIE_SECRET=change-this-to-a-long-random-secret

# Server isolation marker. Only servers carrying this marker are visible in this custom panel.
PANEL_SERVER_TAG=barbie-panel:v2

# GitHub private-repository import (optional). Fine-grained token: Contents=Read for the needed repos.
GITHUB_TOKEN=

# Default provisioning values
DEFAULT_RAM_MB=2048
DEFAULT_CPU_PERCENT=100
DEFAULT_DISK_MB=4096
DEFAULT_SERVER_LIMIT=5

# Optional customer domain base
CUSTOMER_DOMAIN_BASE=customers.yourdomain.com
