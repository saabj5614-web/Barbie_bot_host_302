# Pterodactyl Application API (your own authorized key)
PTERO_URL=https://panel.example.com
PTERO_APP_KEY=

# Owner-only gate for your custom panel
OWNER_PASSWORD=change-this-to-a-long-random-password
OWNER_SESSION_SECRET=change-this-to-a-long-random-secret

# Branding (the upstream Pterodactyl hostname is never returned by the API responses)
PANEL_NAME=Barbie Hosting
PANEL_DOMAIN=panel.yourdomain.com

# Default provisioning values; adjust to the resources actually available on your Pterodactyl node(s)
DEFAULT_RAM_MB=2048
DEFAULT_CPU_PERCENT=100
DEFAULT_DISK_MB=4096
DEFAULT_SERVER_LIMIT=5

# Optional customer domain base. DNS wildcard (*.customers.example.com) must point to your own gateway/proxy.
CUSTOMER_DOMAIN_BASE=customers.yourdomain.com

